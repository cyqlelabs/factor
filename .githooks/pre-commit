#!/bin/sh
# Lint before the commit, because CI lints after the push: an errcheck finding
# is cheap here and costs a red build and a second commit there.
set -e

lint=$(command -v golangci-lint || true)
if [ -z "$lint" ]; then
	lint="$(go env GOPATH)/bin/golangci-lint"
fi
if [ ! -x "$lint" ]; then
	echo "pre-commit: golangci-lint is missing — go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest" >&2
	exit 1
fi

exec "$lint" run
